{
  "name": "sys-calorie-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:vercel": "expo export --platform web --output-dir dist && node scripts/inject-pwa-meta.mjs",
    "build:sites": "expo export --platform web --output-dir dist/client && mkdir -p dist/server && cp hosting/server/index.js dist/server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-font": "~14.0.9",
    "expo-linear-gradient": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  }
}
